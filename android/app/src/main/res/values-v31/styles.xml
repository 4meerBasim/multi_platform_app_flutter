<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window for Android 12+ while the process is starting -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Set transparent icon for Android 12+ splash screen -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
